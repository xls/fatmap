# fatmap CMake package (generated by the Meson build, relocatable).
#
#   find_package(fatmap 0.4 REQUIRED)
#   target_link_libraries(app PRIVATE fatmap::fatmap)    # C API
#   target_link_libraries(app PRIVATE fatmap::fatmapxx)  # + C++17 wrapper
#
# Point CMake at the unpacked archive with -DCMAKE_PREFIX_PATH=<dir> or
# -Dfatmap_DIR=<dir>/lib/cmake/fatmap.
#
# Build: fatmap @VERSION@, threads @THREADS@, profiler @PROFILE@

get_filename_component(_fatmap_prefix "${CMAKE_CURRENT_LIST_DIR}/@PREFIX_FROM_CONFIG@" ABSOLUTE)

if(NOT TARGET fatmap::fatmap)
  if(@SHARED@)
    message(FATAL_ERROR "fatmap: this CMake package only describes static builds")
  endif()

  add_library(fatmap::fatmap STATIC IMPORTED)
  set_target_properties(fatmap::fatmap PROPERTIES
    IMPORTED_LOCATION "${_fatmap_prefix}/@LIBDIR@/@LIBFILE@"
    IMPORTED_LINK_INTERFACE_LANGUAGES "C"
    INTERFACE_INCLUDE_DIRECTORIES "${_fatmap_prefix}/@INCLUDEDIR@")

  if(@NEED_LIBM@)
    set_property(TARGET fatmap::fatmap APPEND PROPERTY INTERFACE_LINK_LIBRARIES m)
  endif()
  if(@NEED_THREADS@)
    include(CMakeFindDependencyMacro)
    set(THREADS_PREFER_PTHREAD_FLAG ON)
    find_dependency(Threads)
    set_property(TARGET fatmap::fatmap APPEND PROPERTY INTERFACE_LINK_LIBRARIES Threads::Threads)
  endif()

  add_library(fatmap::fatmapxx INTERFACE IMPORTED)
  set_target_properties(fatmap::fatmapxx PROPERTIES
    INTERFACE_LINK_LIBRARIES fatmap::fatmap
    INTERFACE_COMPILE_FEATURES cxx_std_17)

  if(NOT EXISTS "${_fatmap_prefix}/@LIBDIR@/@LIBFILE@")
    set(fatmap_FOUND FALSE)
    set(fatmap_NOT_FOUND_MESSAGE "missing ${_fatmap_prefix}/@LIBDIR@/@LIBFILE@")
  endif()
endif()

set(fatmap_VERSION @VERSION@)
set(fatmap_THREADS @THREADS@)
unset(_fatmap_prefix)
