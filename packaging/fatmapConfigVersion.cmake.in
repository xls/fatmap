# fatmap package version file (generated by the Meson build).
# 0.x releases: compatible within the same minor version; 1.x+: same major.
set(PACKAGE_VERSION "@VERSION@")

if(PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
  string(REGEX MATCH "^([0-9]+)\.([0-9]+)" _fm_v "${PACKAGE_VERSION}")
  set(_fm_major "${CMAKE_MATCH_1}")
  set(_fm_minor "${CMAKE_MATCH_2}")
  if(PACKAGE_FIND_VERSION_MAJOR STREQUAL _fm_major AND
     (NOT _fm_major STREQUAL "0" OR PACKAGE_FIND_VERSION_MINOR STREQUAL _fm_minor))
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
  else()
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
  endif()
  if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
  unset(_fm_v)
  unset(_fm_major)
  unset(_fm_minor)
endif()

# a 64 bit build cannot be used from a 32 bit project and vice versa
if(CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P STREQUAL "@SIZEOF_VOID_P@")
  math(EXPR _fm_bits "@SIZEOF_VOID_P@ * 8")
  set(PACKAGE_VERSION "${PACKAGE_VERSION} (${_fm_bits} bit)")
  set(PACKAGE_VERSION_UNSUITABLE TRUE)
  unset(_fm_bits)
endif()
