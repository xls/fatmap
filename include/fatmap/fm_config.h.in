/* fatmap build configuration (generated by the Meson build: see meson.options).
 * Optional features compile in or out as a whole; the API of a disabled
 * feature is not declared. */
#ifndef FATMAP_FM_CONFIG_H
#define FATMAP_FM_CONFIG_H

#define FM_FEATURE_VBO     @FM_FEATURE_VBO@ /* fm3d_buffer */
#define FM_FEATURE_TNL     @FM_FEATURE_TNL@ /* fixed function lighting */
#define FM_FEATURE_SHADERS @FM_FEATURE_SHADERS@ /* programmable stages */
#define FM_FEATURE_SPIRV   @FM_FEATURE_SPIRV@ /* SPIR-V shaders (needs shaders) */

#endif
