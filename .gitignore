# build output
/build*/
/.tools/
# fetched by bootstrap.py / meson into external/ (keep wraps + overlays)
/external/*
!/external/*.wrap
!/external/packagefiles/
# test / bench output
*.png
*.csv
/.clast/
# sample data: only redistributable files are tracked (see data/README.md)
/data/*
!/data/README.md
!/data/Fox.glb
!/data/CesiumMan.glb
!/data/DamagedHelmet.glb
/dist/
__pycache__/
