option('sandbox', type : 'feature', value : 'auto',
  description : 'Build the SDL3 sandbox app (SDL3 is built from external/)')
option('tests', type : 'boolean', value : true,
  description : 'Build tests and the benchmark')
option('profile', type : 'boolean', value : true,
  description : 'Compile built-in profiler zones (fm_profile.h)')
option('tracy', type : 'boolean', value : false,
  description : 'Forward profiler zones to Tracy (needs external/tracy, see bootstrap.py --tracy)')
option('threads', type : 'feature', value : 'auto',
  description : 'Thread pool executor; disabled = no thread library needed, command lists run serially')
option('vbo', type : 'boolean', value : true,
  description : '3D vertex buffers (fm3d_buffer): draw by reference instead of copying')
option('tnl', type : 'boolean', value : true,
  description : '3D fixed function lighting (fm3d_set_light / material)')
option('shaders', type : 'boolean', value : true,
  description : '3D programmable stages (vertex / fragment shader callbacks)')
option('spirv', type : 'boolean', value : true,
  description : 'SPIR-V shaders on the programmable stages (needs shaders)')
option('jit', type : 'boolean', value : true,
  description : 'SPIR-V JIT: shaders as machine code on x86 (the interpreter elsewhere)')
